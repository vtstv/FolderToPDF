<UserControl x:Class="FolderToPDF.UI.Views.ExportHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FolderToPDF.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="950">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & KPI stats -->
            <RowDefinition Height="Auto" /> <!-- Search & Actions Bar -->
            <RowDefinition Height="*" />    <!-- History List -->
        </Grid.RowDefinitions>

        <!-- Row 0: Header & KPI Statistics Card -->
        <ui:Card Grid.Row="0" Margin="0,0,0,16" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Export History &amp; Generated Projects" FontWeight="SemiBold" FontSize="18" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- KPI Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Archive24" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding TotalExports, StringFormat='{}{0:N0} Exports'}" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Cube24" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding TotalExportedTokens, StringFormat='{}~{0:N0} Tokens'}" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="HardDrive24" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding FormattedTotalSize}" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Row 1: Search & Filter Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0"
                        Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Filter by project name, format, or directory..."
                        Icon="{ui:SymbolIcon Search24}"
                        Margin="0,0,8,0" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Command="{Binding LoadItemsCommand}"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           ToolTip="Refresh list"
                           Margin="0,0,8,0" />

                <ui:Button Command="{Binding ClearAllCommand}"
                           Appearance="Danger"
                           Icon="{ui:SymbolIcon Delete24}"
                           Content="Clear History" />
            </StackPanel>
        </Grid>

        <!-- Row 2: History Items List -->
        <Grid Grid.Row="2">
            <!-- Empty State Placeholder -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredItems.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ui:SymbolIcon Symbol="History24" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock Text="No Export Records Found" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" />
                <TextBlock Text="Scanned and exported projects (PDF, TXT, Markdown) will automatically appear here."
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Populated List -->
            <ListView ItemsSource="{Binding FilteredItems}"
                      SelectedItem="{Binding SelectedItem}"
                      Background="Transparent"
                      BorderThickness="0"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.Style>
                    <Style TargetType="ListView">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredItems.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Style>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,0,0,8" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Padding="14,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /> <!-- Format Badge -->
                                    <ColumnDefinition Width="*" />    <!-- Project Info -->
                                    <ColumnDefinition Width="Auto" /> <!-- Metrics & Quick Actions -->
                                </Grid.ColumnDefinitions>

                                <!-- Format Badge -->
                                <Border Grid.Column="0"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        VerticalAlignment="Center"
                                        Margin="0,0,14,0"
                                        MinWidth="64">
                                    <StackPanel HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Document24" FontSize="18" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding Format}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Project Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                   FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding OutputFilePath}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding OutputFilePath}"
                                               Margin="0,0,0,2" />

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Source: " FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{Binding RootDirectory}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="450" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Metrics & Quick Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding TokenCount, StringFormat='{}~{0:N0} tokens'}" FontWeight="Medium" FontSize="12" HorizontalAlignment="Right" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding FileCount, StringFormat='{}{0} files'}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding FormattedSize}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Quick Actions -->
                                    <ui:Button Command="{Binding DataContext.PreviewItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}"
                                               Appearance="Primary"
                                               Icon="{ui:SymbolIcon Eye24}"
                                               ToolTip="Preview inside app"
                                               Margin="0,0,6,0" />

                                    <ui:Button Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}"
                                               Appearance="Secondary"
                                               Icon="{ui:SymbolIcon ArrowUpRight24}"
                                               ToolTip="Open in default app"
                                               Margin="0,0,6,0" />

                                    <ui:Button Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}"
                                               Appearance="Secondary"
                                               Icon="{ui:SymbolIcon FolderOpen24}"
                                               ToolTip="Show in Windows Explorer"
                                               Margin="0,0,6,0" />

                                    <ui:Button Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}"
                                               Appearance="Transparent"
                                               Icon="{ui:SymbolIcon Copy24}"
                                               ToolTip="Copy file path"
                                               Margin="0,0,6,0" />

                                    <ui:Button Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}"
                                               Appearance="Transparent"
                                               Icon="{ui:SymbolIcon Dismiss24}"
                                               ToolTip="Remove from history" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
