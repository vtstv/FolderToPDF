<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>folder-to-pdf.ico</ApplicationIcon>
    <Authors>Murr</Authors>
    <Copyright>Copyright (c) Murr (https://github.com/vtstv). All rights reserved.</Copyright>
    <PackageProjectUrl>https://github.com/vtstv/FolderToPDF</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vtstv/FolderToPDF</RepositoryUrl>
    <Version>2.0.0</Version>
    <Description>Modern, high-performance developer utility to package codebases and directories into clean, token-optimized PDF, TXT, and Markdown documents for LLMs and documentation.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
    <PackageReference Include="SharpToken" Version="2.0.6" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="folder-to-pdf.ico" />
  </ItemGroup>

</Project>