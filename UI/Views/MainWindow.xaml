<ui:FluentWindow x:Class="FolderToPDF.UI.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:FolderToPDF.UI.Views"
                 mc:Ignorable="d"
                 Title="{Binding Title}"
                 Height="850" Width="1200"
                 MinHeight="650" MinWidth="950"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Custom TitleBar -->
            <RowDefinition Height="*" />    <!-- Main Shell -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" Height="40">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                    <ui:Button Command="{Binding ToggleThemeCommand}"
                               Appearance="Transparent"
                               Icon="{ui:SymbolIcon WeatherMoon24}"
                               ToolTip="Toggle Light / Dark Theme"
                               Margin="0,0,8,0" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Main Shell: Left Navigation Bar + Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Padding="12,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- App Brand -->
                    <StackPanel Grid.Row="0" Margin="4,0,0,24">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderZip24" FontSize="24" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="FolderToPDF" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="v2.0 Modern Edition" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="32,2,0,0" />
                    </StackPanel>

                    <!-- Navigation Items List -->
                    <StackPanel Grid.Row="1">
                        <!-- Nav 0: Scanner -->
                        <RadioButton Content="Scan &amp; Package"
                                     GroupName="NavigationTabs"
                                     IsChecked="{Binding CurrentNavigationIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=0, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="0"
                                     Height="40" Margin="0,0,0,4">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="12,8">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Search24" FontSize="18" Margin="0,0,10,0" />
                                            <TextBlock Text="Scan &amp; Package" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Nav 1: Preview -->
                        <RadioButton Content="Files &amp; Preview"
                                     GroupName="NavigationTabs"
                                     IsChecked="{Binding CurrentNavigationIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=1, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="1"
                                     Height="40" Margin="0,0,0,4">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="12,8">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="18" Margin="0,0,10,0" />
                                            <TextBlock Text="Files &amp; Preview" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Nav 2: Result Viewer -->
                        <RadioButton Content="Result Viewer"
                                     GroupName="NavigationTabs"
                                     IsChecked="{Binding CurrentNavigationIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=2, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="2"
                                     Height="40" Margin="0,0,0,4">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="12,8">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="18" Margin="0,0,10,0" />
                                            <TextBlock Text="Result Viewer" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Nav 3: Export History -->
                        <RadioButton Content="Export History"
                                     GroupName="NavigationTabs"
                                     IsChecked="{Binding CurrentNavigationIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=3, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="3"
                                     Height="40" Margin="0,0,0,4">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="12,8">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="History24" FontSize="18" Margin="0,0,10,0" />
                                            <TextBlock Text="Export History" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Nav 4: Presets -->
                        <RadioButton Content="Presets &amp; Profiles"
                                     GroupName="NavigationTabs"
                                     IsChecked="{Binding CurrentNavigationIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=4, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="4"
                                     Height="40" Margin="0,0,0,4">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="12,8">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Bookmark24" FontSize="18" Margin="0,0,10,0" />
                                            <TextBlock Text="Presets &amp; Profiles" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Nav 5: Settings -->
                        <RadioButton Content="Settings"
                                     GroupName="NavigationTabs"
                                     IsChecked="{Binding CurrentNavigationIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=5, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="5"
                                     Height="40" Margin="0,0,0,4">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="12,8">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Settings24" FontSize="18" Margin="0,0,10,0" />
                                            <TextBlock Text="Settings" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </StackPanel>

                    <!-- Bottom Nav: About -->
                    <RadioButton Grid.Row="2"
                                 GroupName="NavigationTabs"
                                 IsChecked="{Binding CurrentNavigationIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=6, Mode=TwoWay}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="6"
                                 Height="40">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Info24" FontSize="18" Margin="0,0,10,0" />
                                        <TextBlock Text="About &amp; Updates" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </Grid>
            </Border>

            <!-- Main Content Switcher -->
            <Grid Grid.Column="1">
                <!-- 0: Scanner View -->
                <views:ScannerView DataContext="{Binding ScannerVm}">
                    <views:ScannerView.Style>
                        <Style TargetType="views:ScannerView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentNavigationIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:ScannerView.Style>
                </views:ScannerView>

                <!-- 1: File Preview View -->
                <views:FilePreviewView DataContext="{Binding FilePreviewVm}">
                    <views:FilePreviewView.Style>
                        <Style TargetType="views:FilePreviewView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentNavigationIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:FilePreviewView.Style>
                </views:FilePreviewView>

                <!-- 2: Document Viewer View -->
                <views:DocumentViewerView DataContext="{Binding DocumentViewerVm}">
                    <views:DocumentViewerView.Style>
                        <Style TargetType="views:DocumentViewerView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentNavigationIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="2">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:DocumentViewerView.Style>
                </views:DocumentViewerView>

                <!-- 3: Export History View -->
                <views:ExportHistoryView DataContext="{Binding ExportHistoryVm}">
                    <views:ExportHistoryView.Style>
                        <Style TargetType="views:ExportHistoryView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentNavigationIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="3">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:ExportHistoryView.Style>
                </views:ExportHistoryView>

                <!-- 4: Profiles View -->
                <views:ProfilesView DataContext="{Binding ProfilesVm}">
                    <views:ProfilesView.Style>
                        <Style TargetType="views:ProfilesView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentNavigationIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="4">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:ProfilesView.Style>
                </views:ProfilesView>

                <!-- 5: Settings View -->
                <views:SettingsView DataContext="{Binding SettingsVm}">
                    <views:SettingsView.Style>
                        <Style TargetType="views:SettingsView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentNavigationIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="5">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:SettingsView.Style>
                </views:SettingsView>

                <!-- 6: About View -->
                <views:AboutView DataContext="{Binding AboutVm}">
                    <views:AboutView.Style>
                        <Style TargetType="views:AboutView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentNavigationIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="6">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:AboutView.Style>
                </views:AboutView>
            </Grid>
        </Grid>

        <!-- Status Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Padding="16,6">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Status: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding ScannerVm.StatusMessage}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ScannerVm.TotalFiles, StringFormat='{}{0:N0} Files'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding ScannerVm.TotalLines, StringFormat='{}{0:N0} Lines'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding ScannerVm.TotalTokens, StringFormat='{}~{0:N0} Tokens'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
