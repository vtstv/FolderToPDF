<UserControl x:Class="FolderToPDF.UI.Views.ScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 0: Source Folder & Preset Hub -->
                <RowDefinition Height="Auto" /> <!-- 1: Filters & Processing (2-Column) -->
                <RowDefinition Height="Auto" /> <!-- 2: Primary Scan Action & Progress -->
                <RowDefinition Height="Auto" /> <!-- 3: Analytics & Token Budget (KPIs) -->
                <RowDefinition Height="Auto" /> <!-- 4: Export & Output Hub -->
            </Grid.RowDefinitions>

            <!-- Row 0: Unified Source Folder & Preset Card -->
            <ui:Card Grid.Row="0" Margin="0,0,0,10" Padding="14,12"
                     AllowDrop="True" Drop="Border_Drop" DragOver="Border_DragOver">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Header + Actions + Preset Dropdown -->
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Source Codebase Directory" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <!-- Preset Dropdown -->
                            <TextBlock Text="Preset:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding AvailableProfiles}"
                                      SelectedItem="{Binding SelectedProfile}"
                                      DisplayMemberPath="Name"
                                      ToolTip="{Binding SelectedProfile.Description}"
                                      Width="260" Height="34"
                                      VerticalContentAlignment="Center"
                                      FontSize="12" Margin="0,0,10,0" />

                            <ui:Button Command="{Binding BrowseDirectoryCommand}"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       Content="Browse Folder"
                                       Height="34" Margin="0,0,6,0" />

                            <ui:Button Command="{Binding ClearFormCommand}"
                                       Appearance="Secondary"
                                       Icon="{ui:SymbolIcon ArrowReset24}"
                                       ToolTip="Reset inputs"
                                       Height="34" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Bottom Bar: Path Input & Drag/Drop Target -->
                    <ui:TextBox Grid.Row="1"
                                Text="{Binding RootDirectory, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Drag and drop a folder here, or enter full path (e.g. C:\Projects\MyRepo)..."
                                Icon="{ui:SymbolIcon FolderZip24}"
                                FontSize="13" Height="36" />
                </Grid>
            </ui:Card>

            <!-- Row 1: Filters & Code Processing (Balanced 2-Column Card) -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: 2x2 File & Folder Filtering Grid -->
                <ui:Card Grid.Column="0" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Filter24" FontSize="16" Margin="0,0,6,0" DockPanel.Dock="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="File &amp; Folder Filtering Rules" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Cell (1,0): Include Extensions -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                            <TextBlock Text="Include Extensions:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3" />
                            <ui:TextBox Text="{Binding FileTypesText, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="*.cs, *.ts, *.py, *.json" Height="30" FontSize="12" />
                        </StackPanel>

                        <!-- Cell (1,2): Exclude Folders -->
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                            <TextBlock Text="Exclude Folders:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3" />
                            <ui:TextBox Text="{Binding ExcludeFoldersText, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="node_modules, bin, obj, .git" Height="30" FontSize="12" />
                        </StackPanel>

                        <!-- Cell (2,0): Exclude Files -->
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Exclude Files / Masks:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3" />
                            <ui:TextBox Text="{Binding ExcludeFilesText, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="*.lock, package-lock.json, *.map" Height="30" FontSize="12" />
                        </StackPanel>

                        <!-- Cell (2,2): Explicit Include Files -->
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Explicit Include Files:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3" />
                            <ui:TextBox Text="{Binding IncludeFilesText, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Dockerfile, Makefile, .env.example" Height="30" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- Right Column: Code Processing & Output Base Name -->
                <ui:Card Grid.Column="2" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="16" Margin="0,0,6,0" DockPanel.Dock="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Sanitization &amp; Output Options" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Row 1: Toggles in compact layout -->
                        <Grid Grid.Row="1" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0" Margin="0,0,6,0">
                                <ui:ToggleSwitch IsChecked="{Binding RedactSecrets}" DockPanel.Dock="Right" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Scrub Secrets" FontWeight="Medium" FontSize="11" />
                                    <TextBlock Text="API keys &amp; tokens" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </DockPanel>

                            <DockPanel Grid.Column="1" Margin="6,0,0,0">
                                <ui:ToggleSwitch IsChecked="{Binding RemoveComments}" DockPanel.Dock="Right" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Strip Comments" FontWeight="Medium" FontSize="11" />
                                    <TextBlock Text="Reduces token size" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0" Margin="0,0,6,0">
                                <ui:ToggleSwitch IsChecked="{Binding IncludeFileTreeHeader}" DockPanel.Dock="Right" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Tree Map" FontWeight="Medium" FontSize="11" />
                                    <TextBlock Text="ASCII folder tree" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </DockPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Output Base Name:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                <ui:TextBox Text="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="codebase_context" Height="28" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ui:Card>
            </Grid>

            <!-- Row 2: Scan Action & Real-time Progress Bar -->
            <ui:Card Grid.Row="2" Margin="0,0,0,10" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <ui:Button Command="{Binding StartScanCommand}"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon Search24}"
                                       Content="Scan &amp; Analyze Codebase"
                                       FontSize="13"
                                       Height="36"
                                       Padding="18,0"
                                       IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />

                            <ui:Button Command="{Binding CancelScanCommand}"
                                       Appearance="Danger"
                                       Icon="{ui:SymbolIcon Dismiss24}"
                                       Content="Cancel"
                                       Height="36"
                                       Margin="8,0,0,0"
                                       Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis" MaxWidth="500" />
                    </DockPanel>

                    <!-- Real-time progress bar -->
                    <ProgressBar Grid.Row="1"
                                 Margin="0,8,0,0"
                                 Height="3"
                                 Value="{Binding ProgressPercentage}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </ui:Card>

            <!-- Row 3: Analytics & Token Budget (4 Compact KPI Cards) -->
            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Files -->
                <ui:Card Grid.Column="0" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Included Files" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalFiles, Converter={StaticResource NumberFormatConverter}}"
                                   FontSize="18" FontWeight="Bold" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding TotalSizeText}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:Card>

                <!-- KPI 2: Lines -->
                <ui:Card Grid.Column="2" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Total Source Lines" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalLines, Converter={StaticResource NumberFormatConverter}}"
                                   FontSize="18" FontWeight="Bold" Margin="0,2,0,0" />
                        <TextBlock Text="Active code lines" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:Card>

                <!-- KPI 3: AI Tokens -->
                <ui:Card Grid.Column="4" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Estimated AI Tokens" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalTokens, Converter={StaticResource NumberFormatConverter}}"
                                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,2,0,0" />
                        <TextBlock Text="o200k / GPT-4o, Claude, Gemini" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:Card>

                <!-- KPI 4: Context Window -->
                <ui:Card Grid.Column="6" Padding="12,10">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Context Window Load" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding ContextWindow128kPercent, StringFormat='{}{0}% of 128k'}"
                                       FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </DockPanel>
                        <ProgressBar Height="4" Margin="0,6,0,4" Value="{Binding ContextWindow128kPercent}" Maximum="100" />
                        <TextBlock Text="{Binding ContextWindow200kPercent, StringFormat='{}{0}% of 200k (Claude 3.5/3.7)'}"
                                   FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- Row 4: Export & Output Hub (Always visible without scrolling!) -->
            <ui:Card Grid.Row="4" Padding="14,10">
                <DockPanel LastChildFill="False">
                    <!-- Export Actions -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="Export:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />

                        <!-- Export PDF -->
                        <ui:Button Command="{Binding ExportPdfCommand}"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon DocumentPdf24}"
                                   Content="Export PDF"
                                   Height="34"
                                   Padding="14,0"
                                   Margin="0,0,8,0" />

                        <!-- Export Markdown -->
                        <ui:Button Command="{Binding ExportMarkdownCommand}"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Document24}"
                                   Content="Export Markdown"
                                   Height="34"
                                   Padding="12,0"
                                   Margin="0,0,8,0" />

                        <!-- Export TXT -->
                        <ui:Button Command="{Binding ExportTxtCommand}"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon DocumentBulletListMultiple24}"
                                   Content="Export TXT"
                                   Height="34"
                                   Padding="12,0"
                                   Margin="0,0,8,0" />

                        <!-- Copy to Clipboard -->
                        <ui:Button Command="{Binding CopyToClipboardCommand}"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Copy24}"
                                   Content="Copy Prompt"
                                   ToolTip="Copies entire formatted Markdown prompt directly to clipboard"
                                   Height="34"
                                   Padding="12,0" />
                    </StackPanel>

                    <!-- Quick System Launchers -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <ui:Button Command="{Binding PreviewLastExportCommand}"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Eye24}"
                                   Content="In-App Preview"
                                   ToolTip="Preview the last generated export in the embedded viewer"
                                   Height="34" Margin="0,0,6,0" />

                        <ui:Button Command="{Binding OpenOutputFileCommand}"
                                   Appearance="Transparent"
                                   Icon="{ui:SymbolIcon Document24}"
                                   Content="External"
                                   ToolTip="Open the last generated document in system default app"
                                   Height="34" Margin="0,0,6,0" />

                        <ui:Button Command="{Binding OpenOutputFolderCommand}"
                                   Appearance="Transparent"
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Content="Open Folder"
                                   ToolTip="Open output directory in Windows Explorer"
                                   Height="34" />
                    </StackPanel>
                </DockPanel>
            </ui:Card>
        </Grid>
    </ScrollViewer>
</UserControl>
