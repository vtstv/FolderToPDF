<UserControl x:Class="FolderToPDF.UI.Views.DocumentViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Toolbar & Document Metadata -->
            <RowDefinition Height="*" />    <!-- Document Content Area -->
        </Grid.RowDefinitions>

        <!-- Row 0: Top Toolbar Card -->
        <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="14,10">
            <DockPanel LastChildFill="False">
                <!-- Left: Document Format Badge & Title -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding DocumentFormat}" FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DocumentTitle}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding CurrentFilePath}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="500" ToolTip="{Binding CurrentFilePath}" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <ui:Button Command="{Binding OpenInExternalAppCommand}"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon ArrowUpRight24}"
                               Content="Open in System App"
                               Height="32" Margin="0,0,6,0" />

                    <ui:Button Command="{Binding OpenContainingFolderCommand}"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Content="Show in Explorer"
                               Height="32" Margin="0,0,6,0" />

                    <ui:Button Command="{Binding CopyFilePathCommand}"
                               Appearance="Transparent"
                               Icon="{ui:SymbolIcon Copy24}"
                               ToolTip="Copy file path"
                               Height="32" Margin="0,0,6,0" />

                    <ui:Button Command="{Binding CloseDocumentCommand}"
                               Appearance="Transparent"
                               Icon="{ui:SymbolIcon Dismiss24}"
                               ToolTip="Close document"
                               Height="32" />
                </StackPanel>
            </DockPanel>
        </ui:Card>

        <!-- Row 1: Document Content Host -->
        <Grid Grid.Row="1">
            <!-- State 1: No Document Loaded Placeholder -->
            <ui:Card Padding="40" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ui:Card.Style>
                    <Style TargetType="ui:Card">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDocument}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Card.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="DocumentSearch24" FontSize="56" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <TextBlock Text="No Document Loaded" FontWeight="SemiBold" FontSize="18" HorizontalAlignment="Center" />
                    <TextBlock Text="Generate a PDF, TXT, or Markdown archive in Scanner, or click 'Preview' in Export History."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </ui:Card>

            <!-- State 2: PDF Document Viewer (WebView2 Edge Chromium PDF Engine) -->
            <Border CornerRadius="8" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasDocument}" Value="True" />
                                    <Condition Binding="{Binding IsPdf}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <wv2:WebView2 x:Name="PdfWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Border>

            <!-- State 3: Markdown / Plain Text Viewer (Monospace) -->
            <ui:Card Padding="12">
                <ui:Card.Style>
                    <Style TargetType="ui:Card">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasDocument}" Value="True" />
                                    <Condition Binding="{Binding IsText}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Card.Style>
                <TextBox Text="{Binding TextContent, Mode=OneWay}"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="12"
                         Background="Transparent"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         BorderThickness="0"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" />
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
