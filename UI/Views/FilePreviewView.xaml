<UserControl x:Class="FolderToPDF.UI.Views.FilePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Search -->
        <ui:Card Grid.Row="0" Margin="0,0,0,16" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="DocumentBulletList24" Margin="0,0,8,0" />
                    <TextBlock Text="Files &amp; Content Preview" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                </StackPanel>

                <ui:TextBox Grid.Column="1"
                            Margin="20,0,20,0"
                            Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search file name or path..."
                            VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Command="{Binding SelectAllCommand}"
                               Appearance="Secondary"
                               Content="Select All"
                               Margin="0,0,8,0" />
                    <ui:Button Command="{Binding DeselectAllCommand}"
                               Appearance="Secondary"
                               Content="Deselect All" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Main Workspace: Split View -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="350" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: File List -->
            <ui:Card Grid.Column="0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="8,4,8,8">
                        <TextBlock Text="{Binding FilteredFiles.Count, StringFormat='{}{0} matching files'}"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </DockPanel>

                    <ListView Grid.Row="1"
                              ItemsSource="{Binding FilteredFiles}"
                              SelectedItem="{Binding SelectedFile}"
                              SelectionMode="Single"
                              BorderThickness="0"
                              Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsIncluded}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RelativePath}"
                                                   FontWeight="Medium"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SizeInBytes, Converter={StaticResource FileSizeConverter}}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding LineCount, StringFormat='{}{0:N0} L'}"
                                                       FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <Border Background="{DynamicResource AccentFillColorTertiaryBrush}"
                                                CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding TokenCount, StringFormat='{}~{0:N0} T'}"
                                                       FontSize="10" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ui:Card>

            <!-- Right Panel: File Previewer -->
            <ui:Card Grid.Column="2" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Preview Header Bar -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="File Inspector" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding SelectedFileInfo}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Cleaned View" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="12" />
                            <ui:ToggleSwitch IsChecked="{Binding ShowCleanedContent}" Margin="0,0,12,0" />
                            
                            <ui:Button Command="{Binding CopyPreviewContentCommand}"
                                       Appearance="Secondary"
                                       Icon="{ui:SymbolIcon Copy24}"
                                       Content="Copy" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Monospace Code Viewer -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            CornerRadius="6"
                            Padding="8">
                        <TextBox Text="{Binding PreviewContent, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True" />
                    </Border>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
