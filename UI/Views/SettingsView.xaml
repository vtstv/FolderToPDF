<UserControl x:Class="FolderToPDF.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Header Card -->
            <ui:Card Grid.Row="0" Margin="0,0,0,16" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Application Settings" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Command="{Binding SaveCommand}"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Save24}"
                                   Content="Save Settings"
                                   Margin="0,0,8,0" />
                        <ui:Button Command="{Binding ResetDefaultsCommand}"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon ArrowReset24}"
                                   Content="Reset Defaults" />
                    </StackPanel>
                </DockPanel>
            </ui:Card>

            <!-- Row 1: Export & Output Destination Card -->
            <ui:Card Grid.Row="1" Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <TextBlock Text="Export &amp; Output Destinations" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />

                    <TextBlock Text="Default Output Folder (Relative or Absolute):" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding DefaultOutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="e.g. C:\Exports or output"
                                    Margin="0,0,8,0" />

                        <ui:Button Grid.Column="1"
                                   Command="{Binding BrowseOutputDirectoryCommand}"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Content="Browse..."
                                   Margin="0,0,8,0" />

                        <ui:Button Grid.Column="2"
                                   Command="{Binding OpenCurrentOutputFolderCommand}"
                                   Appearance="Transparent"
                                   Icon="{ui:SymbolIcon ArrowUpRight24}"
                                   ToolTip="Open folder in File Explorer" />
                    </Grid>

                    <DockPanel Margin="0,0,0,8">
                        <ui:ToggleSwitch IsChecked="{Binding AutoOpenOutputFolder}" DockPanel.Dock="Right" />
                        <StackPanel>
                            <TextBlock Text="Automatically Open Output Folder in Explorer" FontWeight="Medium" />
                            <TextBlock Text="Opens the export directory in Windows File Explorer immediately after export finishes."
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,8">
                        <ui:ToggleSwitch IsChecked="{Binding AutoOpenExportedFile}" DockPanel.Dock="Right" />
                        <StackPanel>
                            <TextBlock Text="Automatically Open Generated Document" FontWeight="Medium" />
                            <TextBlock Text="Launches the generated PDF, TXT, or Markdown archive in your default system viewer."
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel>
                        <ui:ToggleSwitch IsChecked="{Binding NormalizeEmptyLines}" DockPanel.Dock="Right" />
                        <StackPanel>
                            <TextBlock Text="Normalize Consecutive Empty Lines" FontWeight="Medium" />
                            <TextBlock Text="Compresses repetitive blank lines in source code down to single blank lines to reduce token usage."
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ui:Card>

            <!-- Row 2: Appearance & AI Tokenizer Card -->
            <ui:Card Grid.Row="2" Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <TextBlock Text="Appearance &amp; AI Tokenizer Engine" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Application Theme:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailableThemeModes}"
                                      SelectedItem="{Binding ThemeMode}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Default Tokenizer Model:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailableTokenizers}"
                                      SelectedItem="{Binding PreferredTokenizer}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Row 3: PDF & Document Formatting Card -->
            <ui:Card Grid.Row="3" Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <TextBlock Text="Document &amp; PDF Formatting" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Header Font Family:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding TitleFont, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Segoe UI" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Header Font Size:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding TitleFontSize, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="11" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Code Font Family (Monospace):" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding ContentFont, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Consolas" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Code Font Size:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding ContentFontSize, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="8" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Max File Content Truncation Length (characters):" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding TruncatedContentLength, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="250000" Margin="0,0,0,12" />

                    <DockPanel Margin="0,0,0,8">
                        <ui:ToggleSwitch IsChecked="{Binding PdfIncludeLineNumbers}" DockPanel.Dock="Right" />
                        <StackPanel>
                            <TextBlock Text="Include Line Numbers in PDF Exports" FontWeight="Medium" />
                            <TextBlock Text="Prefixes source code lines with formatted line numbering."
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel>
                        <ui:ToggleSwitch IsChecked="{Binding PdfIncludeTableOfContents}" DockPanel.Dock="Right" />
                        <StackPanel>
                            <TextBlock Text="Include Project Structure / Table of Contents" FontWeight="Medium" />
                            <TextBlock Text="Embeds ASCII folder tree directory overview before source listings."
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ui:Card>

            <!-- Row 4: Security & Redaction Rules Card -->
            <ui:Card Grid.Row="4" Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <TextBlock Text="Automated Secret Scrubbing Safeguards" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />

                    <DockPanel Margin="0,0,0,10">
                        <ui:ToggleSwitch IsChecked="{Binding RedactApiKeys}" DockPanel.Dock="Right" />
                        <StackPanel>
                            <TextBlock Text="Redact AI &amp; Cloud API Keys (OpenAI, Anthropic, AWS, GitHub)" FontWeight="Medium" />
                            <TextBlock Text="Replaces sk-..., ghp_..., AKIA..., and Bearer tokens with safe tags."
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,10">
                        <ui:ToggleSwitch IsChecked="{Binding RedactPasswords}" DockPanel.Dock="Right" />
                        <StackPanel>
                            <TextBlock Text="Redact Passwords &amp; Assignment Secrets" FontWeight="Medium" />
                            <TextBlock Text="Replaces password=..., secret=..., and credentials in code/configs."
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,10">
                        <ui:ToggleSwitch IsChecked="{Binding RedactPrivateKeys}" DockPanel.Dock="Right" />
                        <StackPanel>
                            <TextBlock Text="Redact RSA / EC / SSH Private Keys" FontWeight="Medium" />
                            <TextBlock Text="Masks full PEM private key blocks."
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,10">
                        <ui:ToggleSwitch IsChecked="{Binding RedactJwtTokens}" DockPanel.Dock="Right" />
                        <StackPanel>
                            <TextBlock Text="Redact Standalone JWT Tokens" FontWeight="Medium" />
                            <TextBlock Text="Masks standalone 3-part base64 JSON Web Tokens."
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,10">
                        <ui:ToggleSwitch IsChecked="{Binding RedactEmails}" DockPanel.Dock="Right" />
                        <StackPanel>
                            <TextBlock Text="Redact Personal Email Addresses" FontWeight="Medium" />
                            <TextBlock Text="Masks user email addresses found in source files."
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel>
                        <ui:ToggleSwitch IsChecked="{Binding RedactIps}" DockPanel.Dock="Right" />
                        <StackPanel>
                            <TextBlock Text="Redact Public IPv4 / IPv6 Addresses" FontWeight="Medium" />
                            <TextBlock Text="Preserves loopback (127.0.0.1, 0.0.0.0) while masking remote IP addresses."
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ui:Card>
        </Grid>
    </ScrollViewer>
</UserControl>
